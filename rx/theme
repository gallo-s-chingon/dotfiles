#!/usr/bin/env bash
# theme — Unified theme/color switcher for kitty, yazi, nvim, sketchybar (+ optional ghostty, zsh vars)
source "$(dirname "$0")/lib/common.sh"
check_deps jq
PY_TOML="$(command -v python3.11 || true)"

THEME_DIR="${HOME}/.config/colors"
THEME_JSON="${THEME_DIR}/colors.json"
THEME_TOML="${THEME_DIR}/themes.v2.toml"
ACTIVE_FILE="${THEME_DIR}/active_theme.json"
KITTY_THEME="${HOME}/.config/kitty/theme.conf"
YAZI_THEME="${HOME}/.config/yazi/yazi.toml"
GHOSTTY_TEMPLATE="${THEME_DIR}/templates/ghostty.template"
GHOSTTY_THEME="${HOME}/.config/ghostty/theme.conf"
ZSH_THEME_VARS="${THEME_DIR}/current-theme.zsh"

compile_themes_if_needed() {
  [[ -f "$THEME_TOML" ]] || return 0
  [[ -n "$PY_TOML" ]] || { log "python3.11 not found; skipping TOML compile"; return 0; }
  "$PY_TOML" - "$THEME_TOML" "$THEME_JSON" <<'PY'
import json, sys, pathlib
try:
    import tomllib  # py3.11+
    _loads = tomllib.loads
except Exception:
    import tomli    # py3.9/3.10 fallback
    _loads = tomli.loads
src=pathlib.Path(sys.argv[1]); dst=pathlib.Path(sys.argv[2])
data=_loads(src.read_text())
themes=data.get('themes',{})
module_map={}
yazi_map={}
out={'themes':{}}
for slug,t in themes.items():
    term=t.get('terminal',{})
    ansi=term.get('ansi',[])
    if len(ansi)!=16:
        continue
    g={'background':term.get('background'),'foreground':term.get('foreground'),'cursor':term.get('cursor')}
    for i,c in enumerate(ansi):
        g[f'color{i}']=c
    db=t.get('dracula_base',{})
    sem=t.get('semantic',{})
    md={
      'color1_bg':db.get('purple',ansi[4]),
      'color2_bg':db.get('green',ansi[2]),
      'color3_bg':db.get('cyan',ansi[6]),
      'color4_bg':db.get('pink',ansi[5]),
      'color5_bg':db.get('orange',ansi[3]),
      'color6_bg':db.get('comment',ansi[8]),
      'colorInline_bg':sem.get('accent',ansi[13]),
      'color_fg':g['background'],
      'marker_fg':ansi[8]
    }
    ll={
      'normal': {
        'a': {'fg':db.get('bg',g['background']),'bg':sem.get('accent',ansi[4])},
        'b': {'fg':db.get('fg',g['foreground']),'bg':db.get('bgdark',ansi[0])},
        'c': {'fg':db.get('fg',g['foreground']),'bg':db.get('bg',g['background'])}
      },
      'insert': {'a': {'fg':db.get('bg',g['background']),'bg':sem.get('hint',ansi[2])}},
      'visual': {'a': {'fg':db.get('bg',g['background']),'bg':sem.get('accent',ansi[5])}},
      'replace': {'a': {'fg':db.get('bg',g['background']),'bg':sem.get('error',ansi[1])}},
      'command': {'a': {'fg':db.get('bg',g['background']),'bg':sem.get('warn',ansi[3])}},
      'inactive': {
        'a': {'fg':db.get('comment',ansi[8]),'bg':db.get('bg',g['background'])},
        'b': {'fg':db.get('comment',ansi[8]),'bg':db.get('bg',g['background'])},
        'c': {'fg':db.get('comment',ansi[8]),'bg':db.get('bg',g['background'])}
      }
    }
    out['themes'][slug]={
      'name':t.get('meta',{}).get('name',slug),
      'terminal':g,
      'neovim':{'theme':module_map.get(slug,slug),'style':slug},
      'yazi':{'theme':yazi_map.get(slug,slug)},
      'palette':{'render_markdown':md,'lualine':ll},
      'dracula_base':db,
      'semantic':sem
    }
dst.write_text(json.dumps(out,indent=2)+'\n')
PY
}

list_themes() { jq -r '.themes | keys[]' "$THEME_JSON" 2>/dev/null || die "Cannot read $THEME_JSON"; }
current_theme() { jq -r '.active // empty' "$ACTIVE_FILE" 2>/dev/null || list_themes | head -1; }
next_theme() {
  local current="$(current_theme)"
  mapfile -t themes < <(list_themes)
  local idx=0
  for i in "${!themes[@]}"; do
    [[ "${themes[$i]}" == "$current" ]] && idx=$i && break
  done
  echo "${themes[$(( (idx + 1) % ${#themes[@]} ))]}"
}
theme_exists() { jq -e --arg t "$1" '.themes[$t] != null' "$THEME_JSON" >/dev/null; }

apply_kitty() {
  local theme="$1"
  mkdir -p "$(dirname "$KITTY_THEME")"
  jq -r --arg t "$theme" '.themes[$t].terminal as $g |
    "# Auto-generated by theme",
    "background " + $g.background,
    "foreground " + $g.foreground,
    "cursor " + $g.cursor,
    "color0 " + $g.color0,
    "color1 " + $g.color1,
    "color2 " + $g.color2,
    "color3 " + $g.color3,
    "color4 " + $g.color4,
    "color5 " + $g.color5,
    "color6 " + $g.color6,
    "color7 " + $g.color7,
    "color8 " + $g.color8,
    "color9 " + $g.color9,
    "color10 " + $g.color10,
    "color11 " + $g.color11,
    "color12 " + $g.color12,
    "color13 " + $g.color13,
    "color14 " + $g.color14,
    "color15 " + $g.color15' "$THEME_JSON" > "$KITTY_THEME"
  if command -v kitty >/dev/null 2>&1; then
    kitty @ set-colors --all --configured "$KITTY_THEME" 2>/dev/null || true
  fi
}

apply_yazi() {
  local theme="$1"
  local yazi_theme="$(jq -r --arg t "$theme" '.themes[$t].yazi.theme // empty' "$THEME_JSON")"
  [[ -z "$yazi_theme" || ! -f "$YAZI_THEME" ]] && return 0
  local tmp="${YAZI_THEME}.tmp"
  awk -v theme="$yazi_theme" '
    BEGIN { in_root=1; wrote=0 }
    /^\[/ {
      if (in_root && !wrote) {
        print "theme = \"" theme "\""
        wrote=1
      }
      in_root=0
    }
    in_root && /^[[:space:]]*theme[[:space:]]*=/ {
      if (!wrote) {
        print "theme = \"" theme "\""
        wrote=1
      }
      next
    }
    { print }
    END {
      if (!wrote) print "theme = \"" theme "\""
    }
  ' "$YAZI_THEME" > "$tmp" && mv "$tmp" "$YAZI_THEME"
}

apply_ghostty() {
  local theme="$1"
  [[ -f "$GHOSTTY_TEMPLATE" ]] || return 0
  mkdir -p "$(dirname "$GHOSTTY_THEME")"
  cp "$GHOSTTY_TEMPLATE" "$GHOSTTY_THEME"
  for key in BACKGROUND FOREGROUND CURSOR COLOR0 COLOR1 COLOR2 COLOR3 COLOR4 COLOR5 COLOR6 COLOR7 COLOR8 COLOR9 COLOR10 COLOR11 COLOR12 COLOR13 COLOR14 COLOR15; do
    local jq_key
    case "$key" in
      BACKGROUND) jq_key="background" ;;
      FOREGROUND) jq_key="foreground" ;;
      CURSOR) jq_key="cursor" ;;
      *) jq_key="$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')" ;;
    esac
    local val
    val="$(jq -r --arg t "$theme" --arg k "$jq_key" '.themes[$t].terminal[$k] // empty' "$THEME_JSON")"
    [[ -z "$val" ]] && continue
    sed -i '' "s|%%${key}%%|${val}|g" "$GHOSTTY_THEME"
  done
}

write_zsh_vars() {
  local theme="$1"
  local fg bg c1 c2 c3 c4 c5 c6
  fg="$(jq -r --arg t "$theme" '.themes[$t].terminal.foreground' "$THEME_JSON")"
  bg="$(jq -r --arg t "$theme" '.themes[$t].terminal.background' "$THEME_JSON")"
  c1="$(jq -r --arg t "$theme" '.themes[$t].terminal.color1' "$THEME_JSON")"
  c2="$(jq -r --arg t "$theme" '.themes[$t].terminal.color2' "$THEME_JSON")"
  c3="$(jq -r --arg t "$theme" '.themes[$t].terminal.color3' "$THEME_JSON")"
  c4="$(jq -r --arg t "$theme" '.themes[$t].terminal.color4' "$THEME_JSON")"
  c5="$(jq -r --arg t "$theme" '.themes[$t].terminal.color5' "$THEME_JSON")"
  c6="$(jq -r --arg t "$theme" '.themes[$t].terminal.color6' "$THEME_JSON")"
  cat > "$ZSH_THEME_VARS" <<EOF
# Auto-generated by ~/.config/rx/theme
export THEME_SLUG='${theme}'
export THEME_BG='${bg}'
export THEME_FG='${fg}'
export THEME_RED='${c1}'
export THEME_GREEN='${c2}'
export THEME_YELLOW='${c3}'
export THEME_BLUE='${c4}'
export THEME_MAGENTA='${c5}'
export THEME_CYAN='${c6}'
EOF
}

nudge_nvim() {
  if [[ -n "${NVIM:-}" && -S "${NVIM}" ]]; then
    nvim --server "$NVIM" --remote-send ":lua require('themes.init').setup()<CR>" 2>/dev/null || true
  elif [[ -S "/tmp/nvim.sock" ]]; then
    nvim --server "/tmp/nvim.sock" --remote-send ":lua require('themes.init').setup()<CR>" 2>/dev/null || true
  fi
}

reload_sketchybar() {
  if command -v sketchybar >/dev/null 2>&1 && pgrep -x sketchybar >/dev/null 2>&1; then
    sketchybar --reload >/dev/null 2>&1 || true
  fi
}

compile_themes_if_needed

case "${1:-}" in
  --list|-l) list_themes; exit 0 ;;
  --current|-c) current_theme; exit 0 ;;
  --help|-h) echo "Usage: theme [name|--list|--current]"; exit 0 ;;
  "") theme="$(next_theme)" ;;
  -*) die "Unknown option: $1" ;;
  *)
    theme="$1"
    theme_exists "$theme" || die "Theme not found: $theme"
    ;;
esac

mkdir -p "$THEME_DIR"
printf '{"active": "%s"}\n' "$theme" > "$ACTIVE_FILE"
apply_kitty "$theme"
apply_yazi "$theme"
apply_ghostty "$theme"
write_zsh_vars "$theme"
nudge_nvim
reload_sketchybar

echo "Theme: $theme"
